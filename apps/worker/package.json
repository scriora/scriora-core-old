{
  "name": "@scriora/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm exec esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --external:pg --external:@scriora/crypto --external:@scriora/db --external:@scriora/events --external:@scriora/social",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@scriora/crypto": "workspace:*",
    "@scriora/db": "workspace:*",
    "@scriora/events": "workspace:*",
    "@scriora/social": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.15.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
