{
  "name": "scriora-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --if-present --parallel dev",
    "architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
