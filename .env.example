NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/scriora
# Application queries use role scriora_app (created by the tenancy migration).

# 32-byte key as 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:3001/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
